<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.autobox.cluster"
    android:sharedUserId="android.uid.system">

    <!-- Speed: PERF_VEHICLE_SPEED -->
    <uses-permission android:name="android.car.permission.CAR_SPEED"/>
    <!-- Gear: GEAR_SELECTION -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN"/>
    <!-- RPM, oil/coolant temp: ENGINE_RPM, ENGINE_OIL_TEMP, ENGINE_COOLANT_TEMP -->
    <uses-permission android:name="android.car.permission.CAR_ENGINE_DETAILED"/>
    <!-- Fuel level: FUEL_LEVEL -->
    <uses-permission android:name="android.car.permission.CAR_ENERGY"/>
    <!-- Fuel capacity: INFO_FUEL_CAPACITY -->
    <uses-permission android:name="android.car.permission.CAR_INFO"/>
    <!-- Odometer: PERF_ODOMETER -->
    <uses-permission android:name="android.car.permission.CAR_MILEAGE"/>
    <!-- ABS: ABS_ACTIVE -->
    <uses-permission android:name="android.car.permission.CAR_DYNAMICS_STATE"/>
    <!-- Exterior lights and turn signals -->
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_LIGHTS"/>
    <uses-permission android:name="android.car.permission.READ_CAR_EXTERIOR_LIGHTS"/>
    <!-- Seat belt: SEAT_BELT_BUCKLED -->
    <uses-permission android:name="android.car.permission.CONTROL_CAR_SEATS"/>
    <!-- TPMS: TIRE_PRESSURE -->
    <uses-permission android:name="android.car.permission.CAR_TIRES"/>
    <!-- Required to act as the ClusterHome activity -->
    <uses-permission android:name="android.car.permission.CAR_INSTRUMENT_CLUSTER_CONTROL"/>

    <application
        android:name=".ClusterApplication"
        android:label="@string/app_name"
        android:theme="@style/Theme.Cluster"
        android:allowBackup="false"
        android:directBootAware="true"
        android:persistent="true">

        <activity
            android:name=".ClusterActivity"
            android:exported="true"
            android:showForAllUsers="true"
            android:showWhenLocked="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="uiMode|mcc|mnc"
            android:windowSoftInputMode="stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <!-- CarService uses this intent to identify the ClusterHome activity -->
            <intent-filter>
                <action android:name="android.car.cluster.CLUSTER_HOME"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <meta-data android:name="distractionOptimized" android:value="true"/>
        </activity>

    </application>
</manifest>
